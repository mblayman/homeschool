{
  "name": "homeschool",
  "scripts": {
    "build": "tailwindcss --minify -i site.css -o ../static/site.css",
    "watch": "tailwindcss -i site.css -o ../static/site.css --watch",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:install:ci": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": "23.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "2.5.6"
  }
}
